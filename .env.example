# =============================================================
# Business Operations Platform — environment template
# Copy to .env for local development. NEVER commit .env.
# Every service reads configuration from environment only.
# =============================================================

# --- Core ---
APP_ENV=development
SECRET_KEY=change-me

# --- Database (PostgreSQL) ---
POSTGRES_USER=bop
POSTGRES_PASSWORD=bop
POSTGRES_DB=bop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bop:bop@localhost:5432/bop

# --- Redis (queue / cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Email (local: mailpit from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Object storage (platform/storage) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage

# --- Telegram bot service ---
TELEGRAM_BOT_TOKEN=

# --- AI engine (platform/ai gateway) ---
AI_ENGINE_URL=
ANTHROPIC_API_KEY=

# --- Cloudflare Tunnel (AI engine exposure) ---
CLOUDFLARE_TUNNEL_TOKEN=
