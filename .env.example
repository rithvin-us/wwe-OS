# =============================================================
# Business Operations Platform — environment template
# Copy to .env for local development. NEVER commit .env.
# Every service reads configuration from environment only.
# =============================================================

# --- Core ---
APP_ENV=development
SECRET_KEY=change-me

# --- Backend (Django platform kernel) ---
DJANGO_SECRET_KEY=change-me-to-a-32-byte-or-longer-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# JWT lifetimes / auth policy (optional overrides)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REMEMBER_ME_DAYS=30
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=900
PASSWORD_MIN_LENGTH=10

# --- Database (PostgreSQL) ---
POSTGRES_USER=bop
POSTGRES_PASSWORD=bop
POSTGRES_DB=bop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bop:bop@localhost:5432/bop

# --- Redis (queue / cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Email (local: mailpit from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Object storage (platform/storage) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage

# --- Telegram bot service ---
TELEGRAM_BOT_TOKEN=

# --- AI engine (platform/ai gateway) ---
AI_ENGINE_URL=
ANTHROPIC_API_KEY=

# --- Cloudflare Tunnel (AI engine exposure) ---
CLOUDFLARE_TUNNEL_TOKEN=
