# =============================================================
# Business Operations Platform — environment template
# Copy to .env for local development. NEVER commit .env.
# Every service reads configuration from environment only.
# =============================================================

# --- Core ---
APP_ENV=development
SECRET_KEY=change-me

# --- Backend (Django platform kernel) ---
DJANGO_SECRET_KEY=change-me-to-a-32-byte-or-longer-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# JWT lifetimes / auth policy (optional overrides)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REMEMBER_ME_DAYS=30
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=900
PASSWORD_MIN_LENGTH=10
# Touchless Owner face login (auth.face_engine) — points at the SAME face-ai
# microservice HR check-in uses (FACE_AI_API_KEY below is already shared).
# Threshold is deliberately stricter than HR's 1:N attendance match (0.36):
# this one fully replaces a password.
FACE_AI_URL=http://localhost:9000
FACE_LOGIN_MATCH_THRESHOLD=0.45
FACE_LOGIN_MARGIN=0.05

# --- Database (PostgreSQL) ---
POSTGRES_USER=bop
POSTGRES_PASSWORD=bop
POSTGRES_DB=bop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bop:bop@localhost:5432/bop

# --- Redis (queue / cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Email (local: mailpit from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Object storage (platform/storage) ---
# local = filesystem under STORAGE_LOCAL_PATH (dev). s3 | r2 | minio use the
# S3 API via the STORAGE_S3_* block (requires `pip install boto3`).
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage
STORAGE_MAX_UPLOAD_MB=25
# STORAGE_ALLOWED_TYPES=application/pdf,image/png,...   (defaults are sane)
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Invoicing (modules/finance) ---
# The master invoice workbook. Defaults to the copy in the repo; point this at
# your own file to change the format without a code change.
# INVOICE_TEMPLATE_PATH=modules/finance/backend/templates/invoice_template.xlsx
# Printed bill numbers are "<prefix>/<number>/<financial year>".
INVOICE_NUMBER_PREFIX=G/M
# How the sendable PDF is produced. "reportlab" draws it in pure Python and
# works on every host (including Render's native runtime). "libreoffice"
# converts the generated workbook itself — exact, but needs the binary.
INVOICE_PDF_ENGINE=reportlab
# INVOICE_LIBREOFFICE_BIN=libreoffice
# INVOICE_LIBREOFFICE_TIMEOUT=120
# Generated invoices are always written to local disk as well as to whatever
# STORAGE_BACKEND names. Defaults to STORAGE_LOCAL_PATH.
# INVOICE_LOCAL_ARCHIVE_PATH=.storage

# --- Telegram bot service ---
TELEGRAM_BOT_TOKEN=
# Base URL of the running platform backend, and the shared secret that
# authenticates this bot to it. Set PLATFORM_SERVICE_TOKEN to the *token half*
# of the backend's INGESTION_SERVICE_TOKENS entry — i.e. if the backend has
# INGESTION_SERVICE_TOKENS=telegram-bot:my-secret, set this to `my-secret`
# (the bot sends "Authorization: Service my-secret"; the "telegram-bot:" name
# prefix stays on the backend only).
PLATFORM_API_URL=http://localhost:8000
PLATFORM_SERVICE_TOKEN=
# Webhook mode only (leave WEBHOOK_URL blank to run in long-polling mode).
# WEBHOOK_URL is the public base URL that fronts the bot (e.g.
# https://bot.water-works.in); the bot listens on /telegram beneath it.
# WEBHOOK_SECRET is a strong random value (there is NO insecure default) that
# must be registered with Telegram via setWebhook(secret_token=...) — it is the
# only thing that stops spoofed updates. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_URL=
WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to use the bot (blank = open; set
# in production so only known operators can drive OCR/ingestion).
ALLOWED_TELEGRAM_IDS=

# --- Service-to-service ingestion auth (platform side) ---
# Format: "name:token,name:token" — one shared secret per ingestion channel.
# See platform/shared/service_auth.py.
INGESTION_SERVICE_TOKENS=telegram-bot:change-me-to-a-long-random-value

# --- AI engine (platform/ai gateway) & OCR ---
# Set GEMINI_API_KEY for Google Gemini Vision receipt OCR inside the
# Telegram bot and the Platform AI gateway. OCR_MODEL defaults to "gemini-2.5-flash".
GEMINI_API_KEY=
OCR_MODEL=gemini-2.5-flash
AI_ENGINE_URL=
ANTHROPIC_API_KEY=
# Platform AI gateway (platform/ai). "mock" needs no keys and answers
# deterministically — switch to a real model once keys are set.
AI_DEFAULT_MODEL=mock
AI_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_TENANT_HOURLY_LIMIT=200

# --- Cloudflare Tunnel (AI engine exposure) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Face-AI service (services/face-ai) ---
# Shared secret sent as the X-API-Key header on /enroll-face and /verify-face.
# Set the SAME value here (the local face-ai box) and as HR_FACE_AI_API_KEY on
# the platform backend. Leave blank ONLY for fully-local dev (auth disabled).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FACE_AI_API_KEY=
# Platform side: what the HR module sends to the face-ai service. Must equal
# FACE_AI_API_KEY above. (Falls back to FACE_AI_API_KEY if unset.)
HR_FACE_AI_API_KEY=
# Browser origins allowed to call face-ai directly. Leave BLANK in production —
# only the Django backend (server-to-server, CORS-exempt) calls this service.
FACE_AI_CORS_ORIGINS=
# Per-client rate limits (slowapi syntax). Each call runs face matching.
FACE_AI_RATE_VERIFY=30/minute
FACE_AI_RATE_ENROLL=10/minute

# --- Observability (platform backend) ---
# LOG_FORMAT=json emits one JSON object per line for log aggregators;
# "text" (default) is human-readable and still carries the request id.
LOG_FORMAT=text
# Requests slower than this many milliseconds log at WARNING.
SLOW_REQUEST_MS=1000
# /metrics (Prometheus) stays 404 until this scrape token is set; the scraper
# must send "Authorization: Bearer <token>".
METRICS_TOKEN=

# --- Backups (database/backups/backup.sh) ---
BACKUP_RETENTION_DAYS=14
