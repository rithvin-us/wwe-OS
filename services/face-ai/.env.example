# ── Face-AI microservice configuration ──────────────────────────────────────
# Copy to `.env` and adjust. All values have safe defaults in app/config.py.

# Engine: "insightface" (real MTCNN+ArcFace, needs requirements-ml.txt) or
# "stub" (deterministic pseudo-embedding, no heavy deps — for CI/local wiring).
FACE_ENGINE=insightface
FACE_MODEL=buffalo_l
FACE_DETECTOR=mtcnn

# Shared secret. MUST match FACE_AI_API_KEY on the backend. Leave blank ONLY for
# local testing — the tunnel exposes this service publicly.
FACE_AI_API_KEY=

# Quality / liveness gates (see app/config.py for meaning)
MAX_FACE_IMAGE_SIZE=1024
FACE_MIN_SIZE_PX=60
FACE_DETECT_MIN_CONFIDENCE=0.90
FACE_BLUR_MIN_VAR=40.0
FACE_SIDE_PROFILE_MAX_RATIO=0.35
FACE_ENABLE_LIVENESS=true
FACE_LIVENESS_MIN_VAR=60.0
FACE_AI_API_KEY=wwe-secret-key-123

SERVICE_VERSION=1.0.0
